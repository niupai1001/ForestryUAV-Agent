# Keep the build context to source only. Without this the context is the whole
# working directory, which on a development machine is several gigabytes of
# session data, virtual environments and evaluation output that the image never
# reads.
.env
.env.*
!.env.example
.git
.gitignore
.idea
.vscode
__pycache__
**/__pycache__
*.pyc
.pytest_cache
data
backups
test-output
.venv-prosail
evaluation/work
evaluation/results
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
