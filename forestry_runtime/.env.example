# Generate a random token with setup.ps1. Never commit the actual .env.
RUNTIME_API_KEY=replace-with-a-long-random-secret
UI_SESSION_KEY=replace-with-a-different-browser-session-secret
HOST_BRIDGE_KEY=replace-with-a-different-long-random-secret
HOST_BRIDGE_URL=http://host.docker.internal:8011
RUNTIME_DATA_HOST_ROOT=E:/path/to/repository/forestry_runtime/data
AGENT_MAX_ROUNDS=32
MAX_UPLOAD_BYTES=536870912
# The model this machine runs. Setting it here overrides the default in
# compose.yaml, and setup.ps1 reads the same resolved value when it checks or
# pulls the model -- so the preflight and the Runtime cannot ask for different
# ones. Remove the line to fall back to compose.yaml's default.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_THINK=true
OLLAMA_TEMPERATURE=0.2
OLLAMA_CONTEXT=32768
OLLAMA_OUTPUT_TOKENS=8192
KNOWLEDGE_EMBEDDING_MODEL=qwen3-embedding:0.6b
KNOWLEDGE_EMBEDDING_DIM=1024
KNOWLEDGE_EMBED_KEEP_ALIVE=0s
KNOWLEDGE_SEARCHES_PER_TURN=3
# Host directory mounted read-only at /knowledge. The UI indexes /knowledge or a child path.
KNOWLEDGE_HOST_ROOT=E:/path/to/repository/forestry_runtime/knowledge
REMOTE_SENSING_PLUGINS_ENABLED=false
AGENT_JOB_IMAGE=python:3.12-slim
AGENT_JOB_CPUS=4
AGENT_JOB_MEMORY=6g
AGENT_JOB_PIDS=256
AGENT_MAX_ACTIVE_JOBS=1

# Use forward slashes for Windows bind-mount paths.
UAV_INPUT_HOST_ROOT=E:/UAV_INPUT
