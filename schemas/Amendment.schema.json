{
  "$defs": {
    "TaskConstraints": {
      "additionalProperties": false,
      "properties": {
        "allowed_capabilities": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "fs.inputs",
                  "fs.list",
                  "fs.read",
                  "fs.write_workspace",
                  "artifact.inspect",
                  "artifact.read",
                  "action.inspect",
                  "document.read",
                  "knowledge.index",
                  "knowledge.search",
                  "memory.read",
                  "environment.inspect",
                  "code.execute",
                  "job.observe",
                  "role.delegate",
                  "web.search",
                  "web.read"
                ],
                "type": "string"
              },
              "maxItems": 17,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Capabilities"
        }
      },
      "title": "TaskConstraints",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "expected_spec_revision": {
      "minimum": 1,
      "title": "Expected Spec Revision",
      "type": "integer"
    },
    "objective": {
      "maxLength": 32000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "requested_method_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Method Id"
    },
    "constraints": {
      "$ref": "#/$defs/TaskConstraints"
    }
  },
  "required": [
    "request_id",
    "expected_spec_revision",
    "objective"
  ],
  "title": "Amendment",
  "type": "object"
}