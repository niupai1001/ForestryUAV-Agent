{
  "$defs": {
    "TaskConstraints": {
      "additionalProperties": false,
      "properties": {
        "allowed_capabilities": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "fs.inputs",
                  "fs.list",
                  "fs.read",
                  "fs.write_workspace",
                  "artifact.inspect",
                  "artifact.read",
                  "action.inspect",
                  "document.read",
                  "knowledge.index",
                  "knowledge.search",
                  "memory.read",
                  "environment.inspect",
                  "environment.prepare",
                  "code.execute",
                  "job.observe",
                  "role.delegate",
                  "web.search",
                  "web.read",
                  "task.plan"
                ],
                "type": "string"
              },
              "maxItems": 19,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Capabilities"
        }
      },
      "title": "TaskConstraints",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "objective": {
      "maxLength": 32000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Input Refs",
      "type": "array"
    },
    "requested_metrics": {
      "items": {
        "type": "string"
      },
      "title": "Requested Metrics",
      "type": "array"
    },
    "requested_method_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Method Id"
    },
    "model_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Profile"
    },
    "harness_mode": {
      "default": "H2",
      "enum": [
        "H0",
        "H1",
        "H2"
      ],
      "title": "Harness Mode",
      "type": "string"
    },
    "context_classification": {
      "default": "private",
      "enum": [
        "private",
        "public"
      ],
      "title": "Context Classification",
      "type": "string"
    },
    "constraints": {
      "$ref": "#/$defs/TaskConstraints"
    },
    "output_preferences": {
      "additionalProperties": true,
      "title": "Output Preferences",
      "type": "object"
    }
  },
  "required": [
    "request_id",
    "objective"
  ],
  "title": "TaskCreate",
  "type": "object"
}