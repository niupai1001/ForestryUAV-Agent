      "description": "检索本任务授权来源的当前版本，保留明确导入的来源分类、适用条件、局限及冲突。\n\n检查 source_notices，不能使用过期来源或把专家断言当测量验证。无匹配不代表读过来源。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    "write_file": {
      "name": "write_file",
      "description": "写UTF-8并封存；citation_actions={字段名:来源action_id}只附返回顶层citation的真实引用。JSON合字段，Markdown/文本附来源区；产物/记忆回执无citation，标识与SHA/版本写正文。不证明正文正确。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "relative_path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "citation_actions": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "relative_path",
          "content"
        ],
        "type": "object"
      }
    },
    "inspect_action": {
      "name": "inspect_action",
      "description": "读回本任务当前修订的已确认动作；view=citation只返回来源引用，不重读正文。默认result保留完整结果，可能外置。不能授予权限或重做动作。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string"
          },
          "view": {
            "default": "result",
            "enum": [
              "result",
              "citation"
            ],
            "type": "string"
          }
        },
        "required": [
          "action_id"
        ],
        "type": "object"
      }
    },
    "read_user_memory": {
      "name": "read_user_memory",
      "description": "读取当前有效且匹配任务范围的用户笔记。使用前核对声明的来源、条件和局限。\n\n笔记不能授予权限；模型不能更正或写入记忆。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "offset": {
            "default": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "inspect_environment": {
      "name": "inspect_environment",
      "description": "实际检查本机软件/硬件/执行器就绪状态，返回有时间戳的清单。只读诊断，不安装依赖。",
      "schema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "resolve_dependencies": {
      "name": "resolve_dependencies",
      "description": "PEP508解析wheel闭包或源码候选；无target先断网无输入探测(需code.execute)，wait_job后传目标ID。\nbuilt_wheel_artifact_ids复用源码元数据；同请求复用核验快照，refresh=true重新联网须审批。下载IDs合并安装。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "requirements": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "target_artifact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "built_wheel_artifact_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "requirements"
        ],
        "type": "object"
      }
    },
    "acquire_dependencies": {
      "name": "acquire_dependencies",
      "description": "精确name/version/filename下载1–32文件/128MiB，核对PyPI大小/SHA；不执行包。\nwheels只收.whl；source_packages收.tar.gz/.zip。私密任务审批后带approval_id重调。\n解析锁按用途绑定wheels或源码候选；下载的*_artifact_ids交prepare_environment。\n默认核验复用相同请求的已下载文件；refresh=true才重新获取并走原审批。",
      "schema": {
        "$defs": {
          "PackageRequest": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
                "type": "string"
              },
              "version": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.!+_-]{0,99}$",
                "type": "string"
              },
              "filename": {
                "maxLength": 244,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "version",
              "filename"
            ],
            "title": "PackageRequest",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "wheels": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/PackageRequest"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "source": {
            "default": "pypi",
            "enum": [
              "pypi",
              "tuna"
            ],
            "type": "string"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "resolution_lock_artifact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "source_packages": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/PackageRequest"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "prepare_environment": {
      "name": "prepare_environment",
      "description": "*_refs用本地resource_id；下载用wheel_artifact_ids/source_artifact_ids。\n源码需code.execute；static取需求补wheel再dynamic。inspect_build与build_only互斥，后者产wheel；默认装环境，提交后wait_job。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "wheel_refs": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "seconds": {
            "default": 300,
            "type": "integer"
          },
          "wheel_artifact_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "source_refs": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "source_artifact_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "build_only": {
            "default": false,
            "type": "boolean"
          },
          "inspect_build": {
            "anyOf": [
              {
                "enum": [
                  "static",
                  "dynamic"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "type": "object"
      }
    },
    "code_execute": {
      "name": "code_execute",
      "description": "断网Python作业，输入只读到/inputs/<resource_id>，输出/output。\n默认标准库；environment_artifact_id复用确认environment.zip，绑定镜像/SHA。返回持久job_id，用wait_job观察，不重复提交。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "input_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "seconds": {
            "default": 300,
            "type": "integer"
          },
          "environment_artifact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "code",
          "input_refs"
        ],
        "type": "object"
      }
    },
    "process_imagery": {
      "name": "process_imagery",
      "description": "科学影像按文件引用处理，不把整批像素注入模型。\ninspect:raster；build_lut:空输入+参数声明JSON；invert:raster/lut+定标/波段声明JSON；\northomosaic:flight→已发送文件夹ID，或逐航片角色→资源ID；另需ODM声明JSON。\n文件夹由后端展开（当前≤200张顶层航片），不将影像清单/像素塞进上下文。\ninput_refs省略时使用唯一已授权航次目录/已生成正射。先调用本工具，不要逐张文本读取TIFF或抽取单个拍摄组。\n无声明时仅返回匹配数据的旧成果候选及原参数，不导入、不宣称完成；核对本次要求并提供声明后才校验复用。\n输入/声明/算法/预处理/镜像身份完整匹配才封存；反演复用须提供原LUT。旧成果缺血缘仅给候选，不猜测补录。\n旧候选无完整身份但适合当前目标，可传reuse_candidate_id和adoption_note明确采用其旧参数/限制，仍须声明；\n保存采用依据与未知项，不宣称当前算法等价。已知身份不符不能绕过，失效候选不会启动计算。\n返回reused及真实产物后直接交付，不再wait_job。\n沿用Jobs/只读输入/同会话产物/取消和恢复；返回job_id后wait_job，正确LUT/结果直接复用。\n不猜反射率、波段或模型参数，不把光谱残差当现场LAI精度。\n缺少声明时返回所需JSON Schema，不启动作业。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "enum": [
              "inspect",
              "build_lut",
              "invert",
              "orthomosaic"
            ],
            "type": "string"
          },
          "input_refs": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "declaration_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "seconds": {
            "default": 900,
            "type": "integer"
          },
          "resume_job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reuse_candidate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "adoption_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "operation"
        ],
        "type": "object"
      }
    },
    "process_lidar_terrain": {
      "name": "process_lidar_terrain",
      "description": "原始米制高程LAS+授权声明JSON，经固定SMRF/IDW生成地形、支持和HAG。\n只用任务冻结科学镜像/已有code.execute授权和Jobs；返回job_id后wait_job。\n部分科学交付，不含单木/独立精度。已归一化、未知垂直/单位或不可行指定方法拒绝，不替换。",
