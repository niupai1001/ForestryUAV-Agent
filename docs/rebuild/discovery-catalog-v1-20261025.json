    "process_lidar_canopy": {
      "name": "process_lidar_canopy",
      "description": "固定lidR配方的chm/seeds/instances独立阶段；文件角色及授权须完整。\nchm:working/terrain_quality/terrain_support；seeds:chm/chm_record；\ninstances:working/original/hag/chm/chm_record/seeds/seed_record。\n返回job_id后wait_job；复用已完成阶段，不重新归一化或做现场准确性推断。\ninput_refs可使用同会话产物ID，无须重新登记；省略时按完整产品批次自动衔接已有阶段。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "stage": {
            "type": "string"
          },
          "input_refs": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "seconds": {
            "default": 900,
            "type": "integer"
          }
        },
        "required": [
          "stage"
        ],
        "type": "object"
      }
    },
    "wait_job": {
      "name": "wait_job",
      "description": "查询当前任务作业，默认立即返回；显式等待最多seconds秒（0–120），到期如实返回仍在运行，可用同一job_id再查或继续其他交流；应用轮询不调用模型。终态含有界日志末尾/截断标记。失败产物可按artifact_ids读回，先检查并复用正确结果，不能把文件存在当通过或盲目重算。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string"
          },
          "seconds": {
            "default": 0,
            "type": "integer"
          }
        },
        "required": [
          "job_id"
        ],
        "type": "object"
      }
    },
    "set_job_follow_up": {
      "name": "set_job_follow_up",
      "description": "登记后台作业完成后尚欠的分析/报告，自动接回原任务；只需要文件时传null仅通知。\n提交长作业后，若用户目标仍欠分析或报告，登记具体剩余工作，不靠反复wait_job轮询。\n不改变权限、科学参数、执行预算或原任务目标；已经观察/消费的终态不能重复唤醒。",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string"
          },
          "instruction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "job_id"
        ],
        "type": "object"
      }
    }
  }
}